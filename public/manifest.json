{
  "manifest_version": 3,
  "name": "Sigga++",
  "version": "0.7.0",
  "description": "Atalhos e ajustes no SIGAA da UFC para o fluxo do docente.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sigga-mais-mais@brunomateus.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sigga++"
  },
  "content_scripts": [
    {
      "matches": ["*://si3.ufc.br/sigaa/vinculos.jsf*"],
      "js": ["vinculos.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://si3.ufc.br/sigaa/paginaInicial.do*"],
      "js": ["paginaInicial.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://si3.ufc.br/sigaa/ava/FrequenciaAluno/form.jsf*"],
      "css": ["frequencia.css"],
      "all_frames": true,
      "js": ["frequencia.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://si3.ufc.br/sigaa/ava/*",
        "*://si3.ufc.br/sigaa/portais/docente/*",
        "*://si3.ufc.br/sigaa/ensino/consolidacao/*"
      ],
      "js": ["chamada.js", "topicos.js", "notas.js"],
      "run_at": "document_idle"
    }
  ]
}
